PORT=3001
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui
SUPABASE_ANON_KEY=sua-anon-key-aqui
# Token de management (sbp_...) — usado p/ DDL/queries via Supabase Management API (curl)
SUPABASE_ACCESS_TOKEN=sbp_seu-token-de-management-aqui
# Lista separada por virgula, sem espaco. Apex e www sao origens DISTINTAS
# para o browser — liste as duas quando usar dominio proprio. Ex. producao:
# https://web-frontend-10xvagas.azurewebsites.net,https://10xvagas.com.br,https://www.10xvagas.com.br
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Billing Stripe. Use chaves test_* localmente e live_* apenas no ambiente de producao.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CHECKOUT_ENABLED=false
STRIPE_CREDITS_PACK_LOOKUP_KEYS=10xvagas_credits_brl_10,10xvagas_credits_brl_25,10xvagas_credits_brl_50,10xvagas_credits_brl_100
STRIPE_RATE_CARD_ID=rcd_...
STRIPE_LLM_GATEWAY_URL=https://llm.stripe.com
PROFILE_ANALYSIS_MODEL_ID=gpt-5.6-terra
# Ligue somente depois de criar e validar o rate card isolado da 10xVagas.
AI_USAGE_SETTLEMENT_ENABLED=false
